# ============== Python 数据生产者配置 ==============
# source producer.env && python3 producer.py
# 或者在 Windows 上：copy producer.env producer.bat 然后 set 变量

KAFKA_SERVERS=master:9092
KAFKA_TOPIC=device-sensor
MYSQL_HOST=master
MYSQL_USER=root
MYSQL_PASSWORD=060201
MYSQL_DB=predictive_maintenance
DEVICE_COUNT=100
SEND_INTERVAL_SEC=1

# === 模型训练脚本 (train_init_model.py / register_model.py / deploy_model.sh) ===
MODEL_OUTPUT_DIR=/home/hadoop/tmp
HDFS_MODEL_BASE=hdfs://master:9000/models
HDFS_URI=hdfs://master:9000
HDFS_DATA_BASE=hdfs://master:9000/data/history/sensor
KEEP_DAYS=7

# 训练模型类型
MODEL_TYPE=anomaly
